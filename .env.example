CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
# Get them at https://dash.cloudflare.com -> Manage Account -> API Tokens -> Create Token (Edit Cloudflare Workers + D1)
# Or use `npx wrangler whoami` + `npx wrangler d1 list` to find IDs
# Once set, BOTH `npm run dev` (local) and Pages (prod) will query the SAME remote D1.
PORT=4000
